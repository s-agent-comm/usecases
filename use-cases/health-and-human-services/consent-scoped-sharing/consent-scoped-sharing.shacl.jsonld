        }
      ]
    },
    {
      "@id": "_:n4cf8c2d88def4519adc43c88dcce1095b1",
      "sh:namespace": {
        "@type": "xsd:anyURI",
        "@value": "https://w3id.org/agent-ontology/core#"
      },
      "sh:prefix": "core"
    },
    {
      "@id": "_:n4cf8c2d88def4519adc43c88dcce1095b2",
      "sh:namespace": {
        "@type": "xsd:anyURI",
        "@value": "https://w3id.org/agent-ontology/delegation#"
      },
      "sh:prefix": "del"
    },
    {
      "@id": "_:n4cf8c2d88def4519adc43c88dcce1095b3",
      "sh:namespace": {
        "@type": "xsd:anyURI",
        "@value": "https://w3id.org/agent-ontology/capability#"
      },
      "sh:prefix": "cap"
    },
    {
      "@id": "_:n4cf8c2d88def4519adc43c88dcce1095b4",
