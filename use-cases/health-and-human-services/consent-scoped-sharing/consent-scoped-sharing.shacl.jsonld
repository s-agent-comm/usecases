{
  "@context": {
    "acl": "http://www.w3.org/ns/auth/acl#",
    "agent": "https://w3id.org/agent-ontology/agent#",
    "cap": "https://w3id.org/agent-ontology/capability#",
    "core": "https://w3id.org/agent-ontology/core#",
    "dcterms": "http://purl.org/dc/terms/",
    "del": "https://w3id.org/agent-ontology/delegation#",
    "ext": "https://example.org/sac-ucm-ext#",
    "hev": "http://w3id.org/holon/event/",
    "holon": "http://w3id.org/holon/",
    "id": "https://w3id.org/agent-ontology/identity#",
    "intent": "https://w3id.org/agent-ontology/intent#",
    "ledger": "https://w3id.org/agent-ontology/ledger#",
    "prov": "http://www.w3.org/ns/prov#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "sec": "https://w3id.org/agent-ontology/security-binding#",
    "sh": "http://www.w3.org/ns/shacl#",
    "ucm": "https://www.w3.org/ns/ucm#",
    "xsd": "http://www.w3.org/2001/XMLSchema#"
  },
  "@graph": [
    {
      "@id": "https://example.org/sac/hhs/consent-scoped-sharing/shapes#PolicyEnforcedInPodShape",
      "@type": "sh:NodeShape",
      "sh:sparql": {
        "@id": "_:n4cf8c2d88def4519adc43c88dcce1095b18"
      },
      "sh:targetClass": {
        "@id": "ucm:PolicyDefinition"
      }
    },
    {
      "@id": "_:n4cf8c2d88def4519adc43c88dcce1095b18",
      "sh:message": "Each consent policy must be enforced by at least one ACL rule in Delphine's Pod (dcterms:conformsTo).",
      "sh:prefixes": {
        "@id": "https://example.org/sac/hhs/consent-scoped-sharing/shapes#"
      },
      "sh:select": "\n            SELECT $this WHERE {\n                $this a ucm:PolicyDefinition .\n                FILTER NOT EXISTS { ?r a acl:Authorization ; dcterms:conformsTo $this }\n            }"
    },
    {
      "@id": "https://example.org/sac/hhs/consent-scoped-sharing/shapes#",
      "sh:declare": [
        {
          "@id": "_:n4cf8c2d88def4519adc43c88dcce1095b1"
        },
        {
          "@id": "_:n4cf8c2d88def4519adc43c88dcce1095b2"
        },
        {
          "@id": "_:n4cf8c2d88def4519adc43c88dcce1095b3"
        },
        {
