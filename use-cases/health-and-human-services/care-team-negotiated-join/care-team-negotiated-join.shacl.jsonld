      "sh:namespace": {
        "@type": "xsd:anyURI",
        "@value": "https://example.org/sac-ucm-ext#"
      },
      "sh:prefix": "ext"
    },
    {
      "@id": "_:n6a9bb5b44bf743088b2ce6337e698a3ab7",
      "sh:namespace": {
        "@type": "xsd:anyURI",
        "@value": "http://www.w3.org/ns/prov#"
      },
      "sh:prefix": "prov"
    },
    {
      "@id": "_:n6a9bb5b44bf743088b2ce6337e698a3ab8",
      "sh:namespace": {
        "@type": "xsd:anyURI",
        "@value": "http://www.w3.org/ns/auth/acl#"
      },
      "sh:prefix": "acl"
    },
    {
      "@id": "_:n6a9bb5b44bf743088b2ce6337e698a3ab9",
      "sh:namespace": {
        "@type": "xsd:anyURI",
        "@value": "http://purl.org/dc/terms/"
      },
      "sh:prefix": "dcterms"
    },
    {
      "@id": "_:n6a9bb5b44bf743088b2ce6337e698a3ab10",
      "sh:namespace": {
        "@type": "xsd:anyURI",
        "@value": "http://w3id.org/holon/event/"
      },
      "sh:prefix": "hev"
    },
    {
      "@id": "https://example.org/sac/hhs/care-team-negotiated-join/shapes#NegotiatedMembershipShape",
      "@type": "sh:NodeShape",
      "sh:property": {
        "@id": "_:n6a9bb5b44bf743088b2ce6337e698a3ab14"
      },
      "sh:sparql": {
        "@id": "_:n6a9bb5b44bf743088b2ce6337e698a3ab15"
      },
      "sh:targetClass": {
        "@id": "ucm:CareTeam"
      }
    },
    {
      "@id": "_:n6a9bb5b44bf743088b2ce6337e698a3ab14",
      "sh:minCount": 1,
      "sh:path": {
        "@id": "ucm:definedByCriteria"
      }
    },
    {
      "@id": "_:n6a9bb5b44bf743088b2ce6337e698a3ab15",
      "sh:message": "Membership is negotiated: an invited member's organization must have accepted a handshake.",
      "sh:prefixes": {
        "@id": "https://example.org/sac/hhs/care-team-negotiated-join/shapes#"
      },
      "sh:select": "\n            SELECT $this ?value WHERE {\n                $this ucm:hasMember ?value . ?value ucm:affiliatedWith ?org .\n                ?agent prov:actedOnBehalfOf ?org . ?d del:delegatesTo ?agent ; del:delegatedBy ?inviter .\n                FILTER NOT EXISTS { ?inviter prov:actedOnBehalfOf ?p . ?p a ucm:Person }\n                FILTER NOT EXISTS { ?org ucm:acceptsRequest/ucm:occursWithin ?h .\n                                    ?h a ucm:Handshake ; ucm:hasLifecycleState ucm:Accepted }\n            }"
    },
    {
      "@id": "https://example.org/sac/hhs/care-team-negotiated-join/shapes#HandshakeShape",
      "@type": "sh:NodeShape",
      "sh:property": [
        {
          "@id": "_:n6a9bb5b44bf743088b2ce6337e698a3ab11"
        },
        {
          "@id": "_:n6a9bb5b44bf743088b2ce6337e698a3ab12"
        }
      ],
      "sh:sparql": {
        "@id": "_:n6a9bb5b44bf743088b2ce6337e698a3ab13"
      },
      "sh:targetClass": {
        "@id": "ucm:Handshake"
      }
    },
    {
      "@id": "_:n6a9bb5b44bf743088b2ce6337e698a3ab11",
      "sh:class": {
        "@id": "ucm:CareCoordinationInteraction"
      },
      "sh:minCount": 1,
      "sh:path": {
        "@id": "ucm:negotiates"
      }
    },
    {
      "@id": "_:n6a9bb5b44bf743088b2ce6337e698a3ab12",
      "sh:hasValue": {
        "@id": "ucm:Accepted"
      },
      "sh:path": {
        "@id": "ucm:hasLifecycleState"
      }
    },
    {
      "@id": "_:n6a9bb5b44bf743088b2ce6337e698a3ab13",
      "sh:message": "A handshake must be the output of an admitted, recorded action by the accepting agent.",
      "sh:prefixes": {
        "@id": "https://example.org/sac/hhs/care-team-negotiated-join/shapes#"
      },
      "sh:select": "\n            SELECT $this WHERE {\n                $this a ucm:Handshake .\n                FILTER NOT EXISTS { ?act core:producesArtifact $this .\n                                    ?e ledger:action ?act ; ext:verdict \"admit\" }\n            }"
    }
  ]
}
