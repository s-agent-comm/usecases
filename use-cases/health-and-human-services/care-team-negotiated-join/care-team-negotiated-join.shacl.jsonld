        }
      ],
      "sh:targetClass": {
        "@id": "ucm:MatchClaim"
      }
    },
    {
      "@id": "_:n6a9bb5b44bf743088b2ce6337e698a3ab16",
      "sh:minCount": 1,
      "sh:path": {
        "@id": "ucm:statementSubject"
      }
    },
    {
      "@id": "_:n6a9bb5b44bf743088b2ce6337e698a3ab17",
      "sh:minCount": 1,
      "sh:path": {
        "@id": "ucm:madeWithinContext"
      }
    },
    {
      "@id": "_:n6a9bb5b44bf743088b2ce6337e698a3ab18",
      "sh:minCount": 1,
      "sh:path": {
        "@id": "ucm:statementDate"
      }
    },
    {
      "@id": "_:n6a9bb5b44bf743088b2ce6337e698a3ab19",
      "sh:minCount": 1,
      "sh:path": {
        "@id": "_:n6a9bb5b44bf743088b2ce6337e698a3ab20"
      }
    },
    {
      "@id": "_:n6a9bb5b44bf743088b2ce6337e698a3ab20",
      "sh:inversePath": {
        "@id": "core:producesArtifact"
      }
    },
    {
      "@id": "https://example.org/sac/hhs/care-team-negotiated-join/shapes#ConsentTermsShape",
      "@type": "sh:NodeShape",
      "sh:sparql": {
        "@id": "_:n6a9bb5b44bf743088b2ce6337e698a3ab21"
      },
      "sh:targetClass": {
        "@id": "ucm:PolicyDefinition"
      }
    },
    {
      "@id": "_:n6a9bb5b44bf743088b2ce6337e698a3ab21",
      "sh:message": "Terms attached to an acceptance must be enforced by an ACL rule in the Pod (dcterms:conformsTo).",
      "sh:prefixes": {
        "@id": "https://example.org/sac/hhs/care-team-negotiated-join/shapes#"
      },
      "sh:select": "\n            SELECT $this WHERE {\n                $this a ucm:PolicyDefinition .\n                FILTER NOT EXISTS { ?r a acl:Authorization ; dcterms:conformsTo $this }\n            }"
    },
    {
      "@id": "https://example.org/sac/hhs/care-team-negotiated-join/shapes#",
      "sh:declare": [
        {
          "@id": "_:n6a9bb5b44bf743088b2ce6337e698a3ab1"
        },
        {
          "@id": "_:n6a9bb5b44bf743088b2ce6337e698a3ab2"
