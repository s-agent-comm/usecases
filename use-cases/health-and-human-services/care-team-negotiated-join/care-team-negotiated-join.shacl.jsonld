        },
        {
          "@id": "_:n6a9bb5b44bf743088b2ce6337e698a3ab10"
        }
      ]
    },
    {
      "@id": "_:n6a9bb5b44bf743088b2ce6337e698a3ab1",
      "sh:namespace": {
        "@type": "xsd:anyURI",
        "@value": "https://w3id.org/agent-ontology/core#"
      },
      "sh:prefix": "core"
    },
    {
      "@id": "_:n6a9bb5b44bf743088b2ce6337e698a3ab2",
      "sh:namespace": {
        "@type": "xsd:anyURI",
        "@value": "https://w3id.org/agent-ontology/delegation#"
      },
      "sh:prefix": "del"
    },
    {
      "@id": "_:n6a9bb5b44bf743088b2ce6337e698a3ab3",
