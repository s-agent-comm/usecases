          },
          {
            "@id": "del:validFrom"
          }
        ]
      }
    },
    {
      "@id": "_:n6d1781c00f4a4b14939bde912d334596b30",
      "sh:message": "Delegation must be granted by a signed ledger event.",
      "sh:minCount": 1,
      "sh:path": {
        "@id": "_:n6d1781c00f4a4b14939bde912d334596b31"
      }
    },
    {
      "@id": "_:n6d1781c00f4a4b14939bde912d334596b31",
      "sh:inversePath": {
        "@id": "ledger:delegation"
      }
    },
    {
      "@id": "https://example.org/sac/hhs/four-checks#LedgerEventShape",
      "@type": "sh:NodeShape",
      "sh:property": [
        {
          "@id": "_:n6d1781c00f4a4b14939bde912d334596b34"
        },
        {
          "@id": "_:n6d1781c00f4a4b14939bde912d334596b35"
        },
        {
          "@id": "_:n6d1781c00f4a4b14939bde912d334596b36"
        },
        {
          "@id": "_:n6d1781c00f4a4b14939bde912d334596b37"
        },
        {
          "@id": "_:n6d1781c00f4a4b14939bde912d334596b38"
        },
        {
          "@id": "_:n6d1781c00f4a4b14939bde912d334596b39"
        },
        {
          "@id": "_:n6d1781c00f4a4b14939bde912d334596b40"
        },
        {
          "@id": "_:n6d1781c00f4a4b14939bde912d334596b41"
        },
        {
          "@id": "_:n6d1781c00f4a4b14939bde912d334596b42"
        }
      ],
      "sh:sparql": [
        {
          "@id": "_:n6d1781c00f4a4b14939bde912d334596b43"
        },
        {
          "@id": "_:n6d1781c00f4a4b14939bde912d334596b44"
        },
        {
          "@id": "_:n6d1781c00f4a4b14939bde912d334596b45"
        }
      ],
      "sh:targetClass": [
        {
          "@id": "ledger:RuntimeLedgerEvent"
        },
        {
          "@id": "ledger:GovernanceLedgerEvent"
        }
      ]
    },
    {
      "@id": "_:n6d1781c00f4a4b14939bde912d334596b34",
      "sh:maxCount": 1,
      "sh:minCount": 1,
      "sh:path": {
        "@id": "ledger:eventId"
      }
    },
    {
      "@id": "_:n6d1781c00f4a4b14939bde912d334596b35",
      "sh:datatype": {
        "@id": "xsd:integer"
      },
      "sh:maxCount": 1,
      "sh:minCount": 1,
      "sh:path": {
        "@id": "hev:eventSequence"
      }
    },
    {
      "@id": "_:n6d1781c00f4a4b14939bde912d334596b36",
      "sh:maxCount": 1,
      "sh:minCount": 1,
      "sh:path": {
        "@id": "ledger:hash"
      }
    },
    {
      "@id": "_:n6d1781c00f4a4b14939bde912d334596b37",
      "sh:maxCount": 1,
      "sh:path": {
        "@id": "ledger:previousEventHash"
      }
    },
    {
      "@id": "_:n6d1781c00f4a4b14939bde912d334596b38",
      "sh:minCount": 1,
      "sh:path": {
        "@id": "ledger:signature"
      }
    },
    {
      "@id": "_:n6d1781c00f4a4b14939bde912d334596b39",
      "sh:minCount": 1,
      "sh:path": {
        "@id": "ledger:proofType"
      }
    },
    {
      "@id": "_:n6d1781c00f4a4b14939bde912d334596b40",
      "sh:minCount": 1,
      "sh:path": {
        "@id": "ledger:publicKey"
      },
      "sh:pattern": "^did:"
    },
    {
      "@id": "_:n6d1781c00f4a4b14939bde912d334596b41",
      "sh:class": {
        "@id": "core:Agent"
      },
      "sh:maxCount": 1,
      "sh:minCount": 1,
      "sh:path": {
        "@id": "ledger:actor"
      }
    },
    {
      "@id": "_:n6d1781c00f4a4b14939bde912d334596b42",
      "sh:hasValue": true,
      "sh:path": {
        "@id": "ledger:appendOnly"
      }
    },
    {
      "@id": "_:n6d1781c00f4a4b14939bde912d334596b43",
      "sh:message": "Check 2: the event must be signed with a key of its own actor's DID.",
      "sh:prefixes": {
        "@id": "https://example.org/sac/hhs/four-checks#"
      },
      "sh:select": "\n            SELECT $this ?value WHERE {\n                $this ledger:publicKey ?value ; ledger:actor ?a . ?a agent:hasIdentity/id:did ?did .\n                FILTER (!STRSTARTS(?value, CONCAT(?did, \"#\")))\n            }"
    },
    {
      "@id": "_:n6d1781c00f4a4b14939bde912d334596b44",
      "sh:message": "Check 2: the log is not contiguous. previousEventHash must equal the hash of the event one position earlier.",
      "sh:prefixes": {
        "@id": "https://example.org/sac/hhs/four-checks#"
      },
      "sh:select": "\n            SELECT $this WHERE {\n                $this hev:eventSequence ?n .\n                OPTIONAL { $this ledger:previousEventHash ?prev }\n                OPTIONAL { ?before hev:eventSequence ?m ; ledger:hash ?h . FILTER (?m = ?n - 1) }\n                FILTER ( (?n = 1 && BOUND(?prev)) || (?n > 1 && (!BOUND(?prev) || !BOUND(?h) || ?prev != ?h)) )\n            }"
    },
    {
      "@id": "_:n6d1781c00f4a4b14939bde912d334596b45",
      "sh:message": "Check 2: two events share a position or a hash (fork).",
      "sh:prefixes": {
        "@id": "https://example.org/sac/hhs/four-checks#"
      },
      "sh:select": "\n            SELECT $this WHERE {\n                $this hev:eventSequence ?n ; ledger:hash ?h .\n                ?other hev:eventSequence ?n2 ; ledger:hash ?h2 .\n                FILTER (?other != $this && (?n = ?n2 || ?h = ?h2))\n            }"
    },
    {
      "@id": "https://example.org/sac/hhs/four-checks#ConsentShape",
      "@type": "sh:NodeShape",
      "sh:sparql": [
        {
          "@id": "_:n6d1781c00f4a4b14939bde912d334596b17"
        },
        {
          "@id": "_:n6d1781c00f4a4b14939bde912d334596b18"
        },
        {
          "@id": "_:n6d1781c00f4a4b14939bde912d334596b19"
        }
      ],
      "sh:targetClass": {
        "@id": "del:Delegation"
      }
    },
    {
      "@id": "_:n6d1781c00f4a4b14939bde912d334596b17",
      "sh:message": "Consent missing: this delegation grants Pod access, so it needs a consent record (an acl:Authorization) whose acl:agent is the delegate.",
      "sh:prefixes": {
        "@id": "https://example.org/sac/hhs/four-checks#"
      },
      "sh:select": "\n            SELECT $this WHERE {\n                $this del:delegationScope/del:allowedCapability/cap:requiresPermission ?m ; del:delegatesTo ?to .\n                FILTER STRSTARTS(?m, \"http://www.w3.org/ns/auth/acl#\")\n                FILTER NOT EXISTS { $this ext:consentRecord ?r . ?r a acl:Authorization ; acl:agent ?to }\n            }"
    },
    {
      "@id": "_:n6d1781c00f4a4b14939bde912d334596b18",
      "sh:message": "Consent too narrow: a capability in this delegation needs an access mode that no consent record grants.",
      "sh:prefixes": {
        "@id": "https://example.org/sac/hhs/four-checks#"
      },
      "sh:select": "\n            SELECT $this ?value WHERE {\n                $this del:delegationScope/del:allowedCapability ?value . ?value cap:requiresPermission ?m .\n                FILTER STRSTARTS(?m, \"http://www.w3.org/ns/auth/acl#\")\n                FILTER NOT EXISTS { $this ext:consentRecord/acl:mode ?mode . FILTER (STR(?mode) = ?m) }\n            }"
    },
    {
      "@id": "_:n6d1781c00f4a4b14939bde912d334596b19",
      "sh:message": "Consent in the wrong place: the record must be a rule in a .acl resource in the Pod of the person at the root of the chain.",
      "sh:prefixes": {
        "@id": "https://example.org/sac/hhs/four-checks#"
      },
      "sh:select": "\n            SELECT $this ?value WHERE {\n                $this ext:consentRecord ?value .\n                ?chain del:hasDelegation $this , ?root . ?root del:delegatedBy ?issuer .\n                FILTER NOT EXISTS { ?chain del:hasDelegation ?up . ?up del:delegatesTo ?issuer }\n                ?issuer prov:actedOnBehalfOf ?person .\n                BIND (STRBEFORE(STR(?person), \"profile/card.jsonld\") AS ?pod)\n                FILTER (?pod = \"\" || !STRSTARTS(STR(?value), ?pod) || !CONTAINS(STR(?value), \"/.acl#\"))\n            }"
    },
    {
      "@id": "https://example.org/sac/hhs/four-checks#RuntimeEventShape",
      "@type": "sh:NodeShape",
      "sh:property": [
        {
          "@id": "_:n6d1781c00f4a4b14939bde912d334596b46"
        },
        {
          "@id": "_:n6d1781c00f4a4b14939bde912d334596b49"
        },
        {
          "@id": "_:n6d1781c00f4a4b14939bde912d334596b50"
        },
        {
          "@id": "_:n6d1781c00f4a4b14939bde912d334596b51"
        },
        {
          "@id": "_:n6d1781c00f4a4b14939bde912d334596b52"
        }
      ],
      "sh:sparql": {
        "@id": "_:n6d1781c00f4a4b14939bde912d334596b55"
      },
      "sh:targetClass": {
        "@id": "ledger:RuntimeLedgerEvent"
      }
    },
    {
      "@id": "_:n6d1781c00f4a4b14939bde912d334596b46",
      "sh:in": {
        "@list": [
          "admit",
          "deny"
        ]
      },
      "sh:maxCount": 1,
      "sh:minCount": 1,
      "sh:path": {
        "@id": "ext:verdict"
      }
    },
    {
      "@id": "_:n6d1781c00f4a4b14939bde912d334596b49",
      "sh:maxCount": 1,
      "sh:minCount": 1,
      "sh:path": {
        "@id": "ledger:action"
      }
    },
    {
      "@id": "_:n6d1781c00f4a4b14939bde912d334596b50",
      "sh:maxCount": 1,
      "sh:minCount": 1,
      "sh:path": {
        "@id": "ledger:usesCapability"
      }
    },
    {
      "@id": "_:n6d1781c00f4a4b14939bde912d334596b51",
      "sh:maxCount": 1,
      "sh:message": "Every gated action cites exactly one delegation as its authority.",
      "sh:minCount": 1,
      "sh:path": {
        "@id": "ledger:delegation"
      }
    },
    {
      "@id": "_:n6d1781c00f4a4b14939bde912d334596b52",
      "sh:minCount": 1,
      "sh:path": {
        "@list": [
          {
            "@id": "ledger:executionContext"
          },
          {
            "@id": "sec:hasAccessControlRule"
          }
        ]
      }
    },
    {
      "@id": "_:n6d1781c00f4a4b14939bde912d334596b55",
      "sh:message": "Check 3: the verdict does not reproduce. 'admit' requires that the actor is the delegate, the capability is in scope, neither the delegation nor any delegation above it in the chain is revoked or suspended at this point in the log, the target's UCM context is one the capability allows, and, for Pod data, the delegation's consent record grants the actor that access mode on a container holding the target; anything else must be 'deny'.",
      "sh:prefixes": {
        "@id": "https://example.org/sac/hhs/four-checks#"
      },
      "sh:select": "\n            SELECT $this ?value WHERE {\n                $this ext:verdict ?value ; hev:eventSequence ?n ; ledger:actor ?actor ;\n                      ledger:usesCapability ?c ; ledger:delegation ?d .\n                BIND ( EXISTS { ?d del:delegatesTo ?actor } AS ?isDelegate )\n                BIND ( EXISTS { ?d del:delegationScope/del:allowedCapability ?c } AS ?inScope )\n                BIND ( EXISTS { ?g a ledger:GovernanceLedgerEvent ; ledger:delegation ?d ;\n                                   ledger:governanceAction ext:Grant ; hev:eventSequence ?gn . FILTER (?gn < ?n) } AS ?granted )\n                BIND ( EXISTS { ?chain del:hasDelegation ?d , ?anc .\n                                ?d (del:delegatedBy/^del:delegatesTo)* ?anc .\n                                ?s a ledger:GovernanceLedgerEvent ; ledger:delegation ?anc ;\n                                   ledger:governanceAction ?act ; hev:eventSequence ?sn .\n                                FILTER (?act IN (ext:Revoke, ext:Suspend) && ?sn < ?n)\n                                FILTER NOT EXISTS { ?r a ledger:GovernanceLedgerEvent ; ledger:delegation ?anc ;\n                                   ledger:governanceAction ext:Reinstate ; hev:eventSequence ?rn . FILTER (?rn > ?sn && ?rn < ?n) } } AS ?stopped )\n                BIND ( EXISTS { $this ledger:action/(prov:used|core:producesArtifact) ?res . ?res ucm:madeWithinContext/a ?ctxClass .\n                                ?c cap:hasConstraint ?k .\n                                FILTER NOT EXISTS { ?c cap:hasConstraint/cap:allowedContext ?ok . FILTER (?ok = STR(?ctxClass)) } } AS ?wrongContext )\n                BIND ( EXISTS { ?c cap:requiresPermission ?m0 . FILTER STRSTARTS(?m0, \"http://www.w3.org/ns/auth/acl#\") } AS ?needsPod )\n                BIND ( EXISTS { $this ledger:action/(prov:used|core:producesArtifact) ?res .\n                                ?c cap:requiresPermission ?m .\n                                ?d ext:consentRecord ?r . ?r acl:agent ?actor ; acl:mode ?mode ; acl:default ?cont .\n                                FILTER (STR(?mode) = ?m && STRSTARTS(STR(?res), STR(?cont))) } AS ?podAllows )\n                BIND ( IF(?isDelegate && ?inScope && ?granted && !?stopped && !?wrongContext && (!?needsPod || ?podAllows), \"admit\", \"deny\") AS ?expected )\n                FILTER (?value != ?expected)\n            }"
    }
  ]
}
