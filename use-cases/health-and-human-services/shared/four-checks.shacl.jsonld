        },
        {
          "@id": "_:n6d1781c00f4a4b14939bde912d334596b30"
        }
      ],
      "sh:targetClass": {
        "@id": "del:Delegation"
      }
    },
    {
      "@id": "_:n6d1781c00f4a4b14939bde912d334596b20",
      "sh:maxCount": 1,
      "sh:minCount": 1,
      "sh:path": {
        "@id": "del:delegationId"
      }
    },
    {
      "@id": "_:n6d1781c00f4a4b14939bde912d334596b21",
      "sh:class": {
        "@id": "core:Agent"
      },
      "sh:maxCount": 1,
      "sh:minCount": 1,
      "sh:path": {
        "@id": "del:delegatedBy"
      }
    },
    {
      "@id": "_:n6d1781c00f4a4b14939bde912d334596b22",
      "sh:class": {
        "@id": "core:Agent"
      },
      "sh:maxCount": 1,
      "sh:minCount": 1,
      "sh:path": {
        "@id": "del:delegatesTo"
      }
    },
    {
      "@id": "_:n6d1781c00f4a4b14939bde912d334596b23",
      "sh:class": {
        "@id": "del:DelegationScope"
      },
      "sh:maxCount": 1,
      "sh:minCount": 1,
      "sh:path": {
        "@id": "del:delegationScope"
      }
    },
    {
      "@id": "_:n6d1781c00f4a4b14939bde912d334596b24",
      "sh:minCount": 1,
      "sh:path": {
        "@list": [
          {
            "@id": "del:delegationScope"
          },
          {
            "@id": "del:allowedCapability"
          }
        ]
      }
    },
    {
      "@id": "_:n6d1781c00f4a4b14939bde912d334596b27",
      "sh:minCount": 1,
      "sh:path": {
