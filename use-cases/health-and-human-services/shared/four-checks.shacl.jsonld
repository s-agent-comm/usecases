{
  "@context": {
    "acl": "http://www.w3.org/ns/auth/acl#",
    "agent": "https://w3id.org/agent-ontology/agent#",
    "cap": "https://w3id.org/agent-ontology/capability#",
    "core": "https://w3id.org/agent-ontology/core#",
    "dcterms": "http://purl.org/dc/terms/",
    "del": "https://w3id.org/agent-ontology/delegation#",
    "ext": "https://example.org/sac-ucm-ext#",
    "hev": "http://w3id.org/holon/event/",
    "holon": "http://w3id.org/holon/",
    "id": "https://w3id.org/agent-ontology/identity#",
    "intent": "https://w3id.org/agent-ontology/intent#",
    "ledger": "https://w3id.org/agent-ontology/ledger#",
    "prov": "http://www.w3.org/ns/prov#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "sec": "https://w3id.org/agent-ontology/security-binding#",
    "sh": "http://www.w3.org/ns/shacl#",
    "ucm": "https://www.w3.org/ns/ucm#",
    "xsd": "http://www.w3.org/2001/XMLSchema#"
  },
  "@graph": [
    {
      "@id": "https://example.org/sac/hhs/four-checks#AgentShape",
      "@type": "sh:NodeShape",
      "sh:property": [
        {
          "@id": "_:n6d1781c00f4a4b14939bde912d334596b12"
        },
        {
          "@id": "_:n6d1781c00f4a4b14939bde912d334596b15"
        }
      ],
      "sh:sparql": {
        "@id": "_:n6d1781c00f4a4b14939bde912d334596b16"
      },
      "sh:targetClass": {
        "@id": "core:Agent"
      }
    },
    {
      "@id": "_:n6d1781c00f4a4b14939bde912d334596b12",
      "sh:message": "Agent needs a DID.",
      "sh:minCount": 1,
      "sh:path": {
        "@list": [
          {
            "@id": "agent:hasIdentity"
          },
          {
            "@id": "id:did"
          }
        ]
      },
      "sh:pattern": "^did:"
    },
    {
      "@id": "_:n6d1781c00f4a4b14939bde912d334596b15",
      "sh:message": "Agent needs a principal it acts on behalf of (prov:actedOnBehalfOf, as in the Pod's locker agent).",
      "sh:minCount": 1,
      "sh:path": {
        "@id": "prov:actedOnBehalfOf"
      }
    },
    {
      "@id": "_:n6d1781c00f4a4b14939bde912d334596b16",
      "sh:message": "The agent must be identified by an https WebID, so that a Pod's access control rules can name it.",
      "sh:prefixes": {
        "@id": "https://example.org/sac/hhs/four-checks#"
      },
      "sh:select": "SELECT $this WHERE { $this a core:Agent . FILTER (!STRSTARTS(STR($this), \"https://\")) }"
    },
    {
      "@id": "https://example.org/sac/hhs/four-checks#GovernanceEventShape",
      "@type": "sh:NodeShape",
      "sh:property": [
        {
          "@id": "_:n6d1781c00f4a4b14939bde912d334596b56"
        },
        {
          "@id": "_:n6d1781c00f4a4b14939bde912d334596b61"
        }
      ],
      "sh:sparql": [
        {
          "@id": "_:n6d1781c00f4a4b14939bde912d334596b62"
        },
        {
          "@id": "_:n6d1781c00f4a4b14939bde912d334596b63"
        },
        {
          "@id": "_:n6d1781c00f4a4b14939bde912d334596b64"
        }
      ],
      "sh:targetClass": {
        "@id": "ledger:GovernanceLedgerEvent"
      }
    },
    {
      "@id": "_:n6d1781c00f4a4b14939bde912d334596b56",
      "sh:in": {
        "@list": [
          {
            "@id": "ext:Grant"
          },
          {
            "@id": "ext:Revoke"
          },
          {
            "@id": "ext:Suspend"
          },
          {
            "@id": "ext:Reinstate"
          }
        ]
      },
      "sh:maxCount": 1,
      "sh:minCount": 1,
      "sh:path": {
        "@id": "ledger:governanceAction"
      }
    },
    {
      "@id": "_:n6d1781c00f4a4b14939bde912d334596b61",
      "sh:maxCount": 1,
      "sh:minCount": 1,
      "sh:path": {
        "@id": "ledger:delegation"
      }
    },
    {
      "@id": "_:n6d1781c00f4a4b14939bde912d334596b62",
      "sh:message": "Check 4: only the delegator may change a delegation's state.",
      "sh:prefixes": {
        "@id": "https://example.org/sac/hhs/four-checks#"
      },
      "sh:select": "\n            SELECT $this WHERE {\n                $this ledger:actor ?a ; ledger:delegation ?d .\n                FILTER NOT EXISTS { ?d del:delegatedBy ?a }\n            }"
    },
    {
      "@id": "_:n6d1781c00f4a4b14939bde912d334596b63",
      "sh:message": "Check 4: orphaned authorization. Revoking a delegation must also revoke every sub-delegation issued under it.",
      "sh:prefixes": {
        "@id": "https://example.org/sac/hhs/four-checks#"
      },
      "sh:select": "\n            SELECT $this ?value WHERE {\n                $this ledger:governanceAction ext:Revoke ; ledger:delegation ?d .\n                ?d del:delegatesTo ?mid .\n                ?chain del:hasDelegation ?d , ?value .\n                ?value del:delegatedBy ?mid .\n                FILTER NOT EXISTS { ?r a ledger:GovernanceLedgerEvent ; ledger:delegation ?value ;\n                                       ledger:governanceAction ext:Revoke }\n            }"
    },
    {
      "@id": "_:n6d1781c00f4a4b14939bde912d334596b64",
      "sh:message": "Check 4: a revoked delegation must carry an end date (del:validUntil) on its scope.",
      "sh:prefixes": {
        "@id": "https://example.org/sac/hhs/four-checks#"
      },
      "sh:select": "\n            SELECT $this WHERE {\n                $this ledger:governanceAction ext:Revoke ; ledger:delegation ?d .\n                FILTER NOT EXISTS { ?d del:delegationScope/del:validUntil ?t }\n            }"
    },
    {
      "@id": "https://example.org/sac/hhs/four-checks#ChainShape",
      "@type": "sh:NodeShape",
      "sh:sparql": [
        {
          "@id": "_:n6d1781c00f4a4b14939bde912d334596b32"
        },
        {
          "@id": "_:n6d1781c00f4a4b14939bde912d334596b33"
        }
      ],
      "sh:targetClass": {
        "@id": "del:DelegationChain"
      }
    },
    {
      "@id": "_:n6d1781c00f4a4b14939bde912d334596b32",
      "sh:message": "Check 1: a sub-delegation may not grant a capability its parent did not grant (attenuation).",
      "sh:prefixes": {
        "@id": "https://example.org/sac/hhs/four-checks#"
      },
      "sh:select": "\n            SELECT $this ?value WHERE {\n                $this del:hasDelegation ?value , ?parent .\n                ?parent del:delegatesTo ?issuer . ?value del:delegatedBy ?issuer .\n                ?value del:delegationScope/del:allowedCapability ?c .\n                FILTER NOT EXISTS { $this del:hasDelegation ?p2 . ?p2 del:delegatesTo ?issuer ;\n                                    del:delegationScope/del:allowedCapability ?c }\n            }"
    },
    {
      "@id": "_:n6d1781c00f4a4b14939bde912d334596b33",
      "sh:message": "Check 1: the chain needs exactly one root issuer, so every delegation traces back to one principal.",
      "sh:prefixes": {
        "@id": "https://example.org/sac/hhs/four-checks#"
      },
      "sh:select": "\n            SELECT $this WHERE {\n                { SELECT $this (COUNT(DISTINCT ?issuer) AS ?n) WHERE {\n                    $this a del:DelegationChain .\n                    OPTIONAL { $this del:hasDelegation ?root . ?root del:delegatedBy ?issuer .\n                        FILTER NOT EXISTS { $this del:hasDelegation ?up . ?up del:delegatesTo ?issuer } }\n                  } GROUP BY $this }\n                FILTER (?n != 1)\n            }"
    },
    {
      "@id": "https://example.org/sac/hhs/four-checks#",
      "sh:declare": [
        {
          "@id": "_:n6d1781c00f4a4b14939bde912d334596b1"
        },
        {
          "@id": "_:n6d1781c00f4a4b14939bde912d334596b2"
        },
        {
          "@id": "_:n6d1781c00f4a4b14939bde912d334596b3"
        },
        {
          "@id": "_:n6d1781c00f4a4b14939bde912d334596b4"
        },
        {
          "@id": "_:n6d1781c00f4a4b14939bde912d334596b5"
        },
        {
          "@id": "_:n6d1781c00f4a4b14939bde912d334596b6"
        },
        {
          "@id": "_:n6d1781c00f4a4b14939bde912d334596b7"
        },
        {
          "@id": "_:n6d1781c00f4a4b14939bde912d334596b8"
