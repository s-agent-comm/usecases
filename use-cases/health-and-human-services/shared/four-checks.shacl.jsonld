      },
      "sh:prefix": "hev"
    },
    {
      "@id": "https://example.org/sac/hhs/four-checks#DelegationShape",
      "@type": "sh:NodeShape",
      "sh:property": [
        {
          "@id": "_:n6d1781c00f4a4b14939bde912d334596b20"
        },
