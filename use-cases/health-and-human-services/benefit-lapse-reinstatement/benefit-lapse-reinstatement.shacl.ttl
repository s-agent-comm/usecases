# Case-specific shapes for use case D. The four generic checks are in ../shared/four-checks.shacl.ttl.
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix ucm:  <https://www.w3.org/ns/ucm#> .
@prefix ext:  <https://example.org/sac-ucm-ext#> .
@prefix ledger: <https://w3id.org/agent-ontology/ledger#> .
@prefix d:    <https://example.org/sac/hhs/benefit-lapse-reinstatement/shapes#> .

d: sh:declare
    [ sh:prefix "del" ;    sh:namespace "https://w3id.org/agent-ontology/delegation#"^^xsd:anyURI ] ,
    [ sh:prefix "ledger" ; sh:namespace "https://w3id.org/agent-ontology/ledger#"^^xsd:anyURI ] ,
    [ sh:prefix "ucm" ;    sh:namespace "https://www.w3.org/ns/ucm#"^^xsd:anyURI ] ,
    [ sh:prefix "ext" ;    sh:namespace "https://example.org/sac-ucm-ext#"^^xsd:anyURI ] ,
    [ sh:prefix "prov" ;   sh:namespace "http://www.w3.org/ns/prov#"^^xsd:anyURI ] ,
    [ sh:prefix "acl" ;    sh:namespace "http://www.w3.org/ns/auth/acl#"^^xsd:anyURI ] ,
    [ sh:prefix "dcterms" ; sh:namespace "http://purl.org/dc/terms/"^^xsd:anyURI ] ,
    [ sh:prefix "hev" ;    sh:namespace "http://w3id.org/holon/event/"^^xsd:anyURI ] .

d:HouseholdShape a sh:NodeShape ;
    sh:targetClass ucm:Household ;
    sh:property [ sh:path ucm:hasMember ; sh:minCount 2 ] ;
    sh:property [ sh:path ucm:definedByCriteria ; sh:minCount 1 ] ;
    sh:property [ sh:path [ sh:inversePath prov:actedOnBehalfOf ] ; sh:minCount 1 ;
                  sh:message "The household is first-class: it has its own agent." ] .

d:PolicyStaysOutsideShape a sh:NodeShape ;
    sh:targetClass ucm:EligibilityRuleset ;
    sh:property [ sh:path [ sh:inversePath ucm:definedByArtifact ] ; sh:minCount 1 ] .

d:LapseIsVisibleShape a sh:NodeShape ;
    sh:targetSubjectsOf ext:realizesParticipation ;
    sh:sparql [
        sh:message "A suspension in the record must sit between the grant and the reinstatement, and match a closed UCM participation followed by a new one." ;
        sh:prefixes d: ;
        sh:select """
            SELECT $this WHERE {
                ?s ledger:delegation $this ; ledger:governanceAction ext:Suspend ; hev:eventSequence ?sn .
                FILTER NOT EXISTS {
                    ?g ledger:delegation $this ; ledger:governanceAction ext:Grant ; hev:eventSequence ?gn .
                    ?r ledger:delegation $this ; ledger:governanceAction ext:Reinstate ; hev:eventSequence ?rn ; ledger:timestamp ?rt .
                    $this ext:realizesParticipation ?p1 , ?p2 .
                    ?p1 ucm:validTo ?end . ?p2 ucm:validFrom ?rt .
                    FILTER (?gn < ?sn && ?sn < ?rn && ?end < ?rt)
                }
            }""" ] .

d:OrderedWithoutTimestampShape a sh:NodeShape ;
    sh:targetClass ledger:GovernanceLedgerEvent ;
    sh:sparql [
        sh:message "An event without a timestamp must still be placed by its sequence between two timestamped events." ;
        sh:prefixes d: ;
        sh:select """
            SELECT $this WHERE {
                $this hev:eventSequence ?n . FILTER NOT EXISTS { $this ledger:timestamp ?t }
                FILTER NOT EXISTS { ?a hev:eventSequence ?an ; ledger:timestamp ?at . ?b hev:eventSequence ?bn ; ledger:timestamp ?bt .
                                    FILTER (?an < ?n && ?n < ?bn) }
            }""" ] .

d:TrajectoryShape a sh:NodeShape ;
    sh:targetSubjectsOf ucm:validTo ;
    sh:property [ sh:path ucm:hasCareTrajectoryContext ; sh:minCount 2 ;
                  sh:message "A lapse needs 'after' and 'before' trajectory positions when its exact start is unknown." ] .
