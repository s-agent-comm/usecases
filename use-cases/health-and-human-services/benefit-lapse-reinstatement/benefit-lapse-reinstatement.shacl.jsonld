        }
      ],
      "sh:targetClass": {
        "@id": "ucm:Household"
      }
    },
    {
      "@id": "_:n9b80e2d3517347e6b403fa0b64181c9cb9",
      "sh:minCount": 2,
      "sh:path": {
        "@id": "ucm:hasMember"
      }
    },
