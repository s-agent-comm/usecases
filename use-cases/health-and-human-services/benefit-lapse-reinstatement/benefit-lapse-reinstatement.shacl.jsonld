    {
      "@id": "https://example.org/sac/hhs/benefit-lapse-reinstatement/shapes#LapseIsVisibleShape",
      "@type": "sh:NodeShape",
      "sh:sparql": {
        "@id": "_:n9b80e2d3517347e6b403fa0b64181c9cb15"
      },
      "sh:targetSubjectsOf": {
        "@id": "ext:realizesParticipation"
      }
    },
    {
      "@id": "_:n9b80e2d3517347e6b403fa0b64181c9cb15",
      "sh:message": "A suspension in the record must sit between the grant and the reinstatement, and match a closed UCM participation followed by a new one.",
      "sh:prefixes": {
        "@id": "https://example.org/sac/hhs/benefit-lapse-reinstatement/shapes#"
      },
      "sh:select": "\n            SELECT $this WHERE {\n                ?s ledger:delegation $this ; ledger:governanceAction ext:Suspend ; hev:eventSequence ?sn .\n                FILTER NOT EXISTS {\n                    ?g ledger:delegation $this ; ledger:governanceAction ext:Grant ; hev:eventSequence ?gn .\n                    ?r ledger:delegation $this ; ledger:governanceAction ext:Reinstate ; hev:eventSequence ?rn ; ledger:timestamp ?rt .\n                    $this ext:realizesParticipation ?p1 , ?p2 .\n                    ?p1 ucm:validTo ?end . ?p2 ucm:validFrom ?rt .\n                    FILTER (?gn < ?sn && ?sn < ?rn && ?end < ?rt)\n                }\n            }"
    },
    {
      "@id": "https://example.org/sac/hhs/benefit-lapse-reinstatement/shapes#PolicyStaysOutsideShape",
      "@type": "sh:NodeShape",
      "sh:property": {
        "@id": "_:n9b80e2d3517347e6b403fa0b64181c9cb13"
      },
      "sh:targetClass": {
        "@id": "ucm:EligibilityRuleset"
      }
    },
    {
      "@id": "_:n9b80e2d3517347e6b403fa0b64181c9cb13",
      "sh:minCount": 1,
      "sh:path": {
        "@id": "_:n9b80e2d3517347e6b403fa0b64181c9cb14"
      }
    },
    {
      "@id": "_:n9b80e2d3517347e6b403fa0b64181c9cb14",
      "sh:inversePath": {
        "@id": "ucm:definedByArtifact"
      }
    },
    {
      "@id": "https://example.org/sac/hhs/benefit-lapse-reinstatement/shapes#TrajectoryShape",
      "@type": "sh:NodeShape",
      "sh:property": {
        "@id": "_:n9b80e2d3517347e6b403fa0b64181c9cb17"
      },
      "sh:targetSubjectsOf": {
        "@id": "ucm:validTo"
      }
    },
    {
      "@id": "_:n9b80e2d3517347e6b403fa0b64181c9cb17",
      "sh:message": "A lapse needs 'after' and 'before' trajectory positions when its exact start is unknown.",
      "sh:minCount": 2,
      "sh:path": {
        "@id": "ucm:hasCareTrajectoryContext"
      }
    },
    {
      "@id": "https://example.org/sac/hhs/benefit-lapse-reinstatement/shapes#OrderedWithoutTimestampShape",
      "@type": "sh:NodeShape",
      "sh:sparql": {
        "@id": "_:n9b80e2d3517347e6b403fa0b64181c9cb16"
      },
      "sh:targetClass": {
        "@id": "ledger:GovernanceLedgerEvent"
      }
    },
    {
      "@id": "_:n9b80e2d3517347e6b403fa0b64181c9cb16",
      "sh:message": "An event without a timestamp must still be placed by its sequence between two timestamped events.",
      "sh:prefixes": {
        "@id": "https://example.org/sac/hhs/benefit-lapse-reinstatement/shapes#"
      },
      "sh:select": "\n            SELECT $this WHERE {\n                $this hev:eventSequence ?n . FILTER NOT EXISTS { $this ledger:timestamp ?t }\n                FILTER NOT EXISTS { ?a hev:eventSequence ?an ; ledger:timestamp ?at . ?b hev:eventSequence ?bn ; ledger:timestamp ?bt .\n                                    FILTER (?an < ?n && ?n < ?bn) }\n            }"
    },
    {
      "@id": "https://example.org/sac/hhs/benefit-lapse-reinstatement/shapes#HouseholdShape",
