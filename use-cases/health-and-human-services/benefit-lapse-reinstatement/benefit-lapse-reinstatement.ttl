    ledger:timestamp "2026-11-10T09:00:00Z"^^xsd:dateTime ;
    ledger:actor dlock:locker-agent ; ledger:delegation :d1 ;
    ledger:governanceAction ext:Grant ;
    ledger:hash "sha256:6c11fc13b2a5ffe1c5284f80a640e40ccfe125e4434e795be94979b5fb20ac39" ;
    ledger:proofType "DataIntegrityProof" ; ledger:publicKey "did:web:pod.example:delphine#key-1" ;
    ledger:signature "placeholder-signature-6c11fc13b2a5" .
