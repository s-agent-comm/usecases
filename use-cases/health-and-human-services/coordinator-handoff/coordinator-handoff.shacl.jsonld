          "@id": "_:na4290d41f3024d55af0d0f3d024b12cfb8"
        }
      ]
    },
    {
      "@id": "_:na4290d41f3024d55af0d0f3d024b12cfb1",
      "sh:namespace": {
        "@type": "xsd:anyURI",
        "@value": "https://w3id.org/agent-ontology/delegation#"
      },
      "sh:prefix": "del"
    },
    {
      "@id": "_:na4290d41f3024d55af0d0f3d024b12cfb2",
