    ledger:actor rb:agent ; ledger:delegation :d1 ;
    ledger:usesCapability :capCoordinate ; ledger:action :actHandoffNote ; ext:verdict "admit" ;
    ledger:executionContext :gate ;
    ledger:previousEventHash "sha256:60a3647c27dd6c984093206f3dcb4a09f0ff70c43d0ba4cbd6ccd69aa4ecd58a" ;
